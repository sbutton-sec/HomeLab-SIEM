<!--
  Homelab custom rules (Wazuh 4.14) - added 2026-11-25, revised 16:05
  Internal networks: LAN 10.66.66.0/24, WireGuard VPN 10.10.10.0/24
  ID ranges: 1001xx Suricata | 1002xx OPNsense GUI | 1003xx firewall blocks
  Design: no "catch-all" sibling rules. Each child has one clear condition.
-->

<!-- ============ Suricata (OPNsense IDS) noise tuning ============ -->
<group name="local,suricata,ids,">

  <rule id="100100" level="0">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">^ET INFO Session Traversal Utilities for NAT \(STUN</field>
    <description>Suricata: STUN (normal voice/video call traffic) - ignored.</description>
  </rule>

  <rule id="100101" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^1$</field>
    <description>Suricata HIGH severity: $(alert.signature)</description>
  </rule>

  <rule id="100102" level="7">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^2$</field>
    <description>Suricata MEDIUM severity: $(alert.signature)</description>
  </rule>

</group>

<!-- ============ OPNsense web GUI logins (decoder: opnsense-audit) ============ -->
<group name="local,opnsense,">

  <rule id="100200" level="0">
    <decoded_as>opnsense-audit</decoded_as>
    <description>OPNsense audit event.</description>
  </rule>

  <rule id="100201" level="3">
    <if_sid>100200</if_sid>
    <match>Successful login for user</match>
    <description>OPNsense: web GUI login by '$(dstuser)' from $(srcip).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100204" level="12">
    <if_sid>100201</if_sid>
    <srcip negate="yes">10.66.66.0/24</srcip>
    <description>OPNsense: web GUI login by '$(dstuser)' from OUTSIDE your networks ($(srcip)).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100203" level="7">
    <if_sid>100204</if_sid>
    <srcip>10.10.10.0/24</srcip>
    <description>OPNsense: web GUI login by '$(dstuser)' over WireGuard VPN ($(srcip)).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100205" level="3">
    <if_sid>100200</if_sid>
    <match>User logged out</match>
    <description>OPNsense: web GUI logout by '$(dstuser)' from $(srcip).</description>
  </rule>

  <rule id="100206" level="5">
    <if_sid>100200</if_sid>
    <match>Web GUI authentication error</match>
    <description>OPNsense: FAILED web GUI login for '$(dstuser)' from $(srcip).</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100207" level="10" frequency="5" timeframe="120" ignore="300">
    <if_matched_sid>100206</if_matched_sid>
    <same_source_ip />
    <description>OPNsense: possible brute force - 5 failed web GUI logins from $(srcip) in 2 minutes.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>

<!-- ============ Firewall blocks (built-in 87702 = 18 blocks in 45s from one source) ============ -->
<group name="local,pfsense,firewall,">

  <rule id="100300" level="10">
    <if_sid>87702</if_sid>
    <srcip>10.66.66.0/24</srcip>
    <description>Firewall: LAN device $(srcip) is repeatedly being blocked.</description>
    <group>multiple_blocks,</group>
  </rule>

  <rule id="100302" level="3">
    <if_sid>87702</if_sid>
    <srcip negate="yes">10.66.66.0/24</srcip>
    <description>Firewall: internet traffic from $(srcip) blocked repeatedly (expected background noise).</description>
    <group>multiple_blocks,</group>
  </rule>

  <rule id="100301" level="10">
    <if_sid>100302</if_sid>
    <srcip>10.10.10.0/24</srcip>
    <description>Firewall: WireGuard VPN device $(srcip) is repeatedly being blocked.</description>
    <group>multiple_blocks,</group>
  </rule>

</group>

<!-- ============ Batch 2 (2026-11-25): SSH, sudo, new users ============ -->
<group name="local,linux,sshd,">

  <rule id="100500" level="12">
    <if_sid>5715</if_sid>
    <srcip negate="yes">10.66.66.0/24</srcip>
    <description>SSH: login by '$(dstuser)' from OUTSIDE your networks ($(srcip)).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100501" level="7">
    <if_sid>100500</if_sid>
    <srcip>10.10.10.0/24</srcip>
    <description>SSH: login by '$(dstuser)' over WireGuard VPN ($(srcip)).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100502" level="10">
    <if_sid>5715</if_sid>
    <srcip>10.66.66.0/24</srcip>
    <user>^root$</user>
    <description>SSH: direct ROOT login from $(srcip).</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100503" level="8">
    <if_sid>5715</if_sid>
    <srcip>10.66.66.0/24</srcip>
    <user negate="yes">^root$</user>
    <time>10 pm - 6 am</time>
    <description>SSH: out-of-hours login by '$(dstuser)' from $(srcip).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100510" level="8">
    <if_sid>5402</if_sid>
    <time>10 pm - 6 am</time>
    <description>sudo: out-of-hours sudo to root by '$(srcuser)'.</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <rule id="100520" level="10">
    <if_sid>5902</if_sid>
    <description>New local user account '$(dstuser)' created.</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_changed,</group>
  </rule>

</group>

<!-- ============ Batch 2: Proxmox VE (built-in 87201 failed, 87202 brute force, 87203 success) ============ -->
<group name="local,proxmox-ve,">

  <rule id="100400" level="12">
    <if_sid>87201</if_sid>
    <regex type="pcre2" negate="yes">rhost=(?:::ffff:)?10\.(?:66\.66|10\.10)\.\d+ </regex>
    <description>Proxmox: FAILED login for '$(dstuser)' from OUTSIDE your networks ($(srcip)).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100401" level="10">
    <if_sid>87203</if_sid>
    <user>^root$</user>
    <description>Proxmox: web GUI login as ROOT (a named admin account is normally used).</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

</group>

<!-- ============ Batch 3 (2026-11-25): file integrity monitoring ============ -->
<group name="local,syscheck,fim,">

  <rule id="100600" level="12">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/ssh/|^/etc/sudoers|^/root/\.ssh/|^/home/[^/]+/\.ssh/</field>
    <description>FIM: critical access file changed: $(file)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <rule id="100601" level="10">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/cron|^/etc/systemd/system/</field>
    <description>FIM: scheduled task or service changed (possible persistence): $(file)</description>
    <mitre>
      <id>T1053</id>
    </mitre>
  </rule>

  <rule id="100602" level="10">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/pihole/pihole\.toml|^/etc/unbound/</field>
    <description>FIM: DNS server configuration changed: $(file)</description>
  </rule>

  <rule id="100603" level="10">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/pve/</field>
    <description>FIM: Proxmox configuration changed: $(file)</description>
  </rule>

</group>

<!-- ============ Batch 4 (2026-11-26): noise tuning from collected data ============ -->
<group name="local,tuning,">

  <!-- Proxmox has no sudo: the admin PC logs in as root by design (5 Telegram alerts on 26 Nov). -->
  <rule id="100504" level="3">
    <if_sid>100502</if_sid>
    <hostname>^pve$</hostname>
    <srcip>10.66.66.66</srcip>
    <description>SSH: expected root login to the Proxmox host from the admin PC ($(srcip)).</description>
  </rule>

  <!-- Suricata severity 2 ".biz TLD" lookups: informational, ~55/day from a LAN device. -->
  <rule id="100103" level="3">
    <if_sid>100102</if_sid>
    <field name="alert.signature" type="pcre2">^ET INFO Observed DNS Query to \.biz TLD</field>
    <description>Suricata: DNS query to a .biz domain (informational, tuned down from 7).</description>
  </rule>

</group>
