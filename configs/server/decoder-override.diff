+<!-- ===== OPNsense web GUI audit log (added 2026-11-25) =====
+     OPNsense logs GUI logins as program "audit", the same name Solaris BSM uses.
+     These decoders sit BEFORE solaris_bsm so OPNsense lines are matched first. -->
+<decoder name="opnsense-audit">
+  <program_name>^audit$</program_name>
+  <prematch type="pcre2">\.php|WebGui|\buser \S+ </prematch>
+</decoder>
+
+<decoder name="opnsense-audit-fields">
+  <parent>opnsense-audit</parent>
+  <regex type="pcre2">for (?:user )?'([^']+)' from:? (\d{1,3}(?:\.\d{1,3}){3})</regex>
+  <order>dstuser, srcip</order>
+</decoder>
+
+<decoder name="opnsense-audit-fields">
+  <parent>opnsense-audit</parent>
+  <regex type="pcre2">\buser (\S+) .*? at (\d{1,3}(?:\.\d{1,3}){3})</regex>
+  <order>dstuser, srcip</order>
+</decoder>
+
+<decoder name="opnsense-audit-fields">
+  <parent>opnsense-audit</parent>
+  <regex type="pcre2">(/[\w./-]+\.php):</regex>
+  <order>url</order>
+</decoder>
+
 <decoder name="solaris_bsm">
   <program_name>^audit$</program_name>
 </decoder>

